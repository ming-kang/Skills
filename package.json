{
  "name": "agent-skills",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:visualize && npm run test:pptd",
    "test:visualize": "python -B -m unittest discover -s tools/visualize -p test_*.py",
    "test:pptd": "node --test \"tools/pptd/tests-node/*.test.js\" && python -B -m unittest discover -s tools/pptd/tests -p \"test_*.py\"",
    "pptd:serve": "node pptd/scripts/serve.mjs",
    "visualize:build": "python tools/visualize/build_gallery.py",
    "visualize:render": "node tools/visualize/render_gallery.mjs",
    "visualize:validate": "python -B visualize/scripts/validate_svg.py --strict -q visualize/assets",
    "visualize:palette": "python tools/visualize/check_palette.py"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
